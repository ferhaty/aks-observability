# Copy into the EXISTING AKS root; adapt only its existing resource/variable names
# and local source path. Keep that root's backend and authentication unchanged.
# Add Azure/azapi = 2.13.0 to its required_providers; AzureRM = 5.12.0.
# Do not add module-wide depends_on: AKS consumes the LAW output below.
module "monitoring" {
  source              = "../modules/azure-monitor"
  name                = var.monitoring_name
  resource_group_name = azurerm_resource_group.aks.name
  resource_group_id   = azurerm_resource_group.aks.id
  location            = var.location
  subscription_id     = var.subscription_id
  tenant_id           = var.tenant_id
  aks_id              = azurerm_kubernetes_cluster.aks.id
  oidc_issuer_url     = azurerm_kubernetes_cluster.aks.oidc_issuer_url
}
variable "monitoring_name" { type = string }
output "observability_inputs" {
  value = { environment = module.monitoring.workload_inputs }
}
output "monitoring_inspection" { value = module.monitoring.inspection }
