# MERGE requirements into the existing AKS root; do not replace its backend,
# other providers, aliases or existing AzureRM authentication configuration.
terraform {
  required_version = ">= 1.10.0, < 2.0.0"
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "5.12.0" }
    azapi   = { source = "Azure/azapi", version = "2.13.0" }
  }
}
provider "azapi" {
  subscription_id            = var.subscription_id
  skip_provider_registration = true
  enable_preflight           = false
}
