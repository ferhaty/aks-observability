fullnameOverride: otel-collector
mode: deployment
replicaCount: 1
rollout: {strategy: Recreate, rollingUpdate: {}}
autoscaling: {enabled: false}
image: {repository: otel/opentelemetry-collector-contrib, tag: '0.162.0'}
command: {name: otelcol-contrib}
serviceAccount:
  create: true
  name: otel-collector
  automountServiceAccountToken: false
  annotations:
    azure.workload.identity/client-id: '${client_id}'
    azure.workload.identity/tenant-id: '${tenant_id}'
podLabels:
  azure.workload.identity/use: 'true'
clusterRole: {create: false}
presets:
  logsCollection: {enabled: false}
  hostMetrics: {enabled: false}
  kubernetesAttributes: {enabled: false}
  kubeletMetrics: {enabled: false}
  kubernetesEvents: {enabled: false}
  kubernetesObjects: {enabled: false}
  clusterMetrics: {enabled: false}
  annotationDiscovery: {logs: {enabled: false}, metrics: {enabled: false}}
  profiling: {enabled: false}
  resourceDetection: {enabled: false}
resources:
  requests: {cpu: 100m, memory: 256Mi}
  limits: {memory: 512Mi}
ports:
  otlp: {enabled: true, containerPort: 4317, servicePort: 4317, hostPort: null}
  otlp-http: {enabled: false}
  jaeger-compact: {enabled: false}
  jaeger-thrift: {enabled: false}
  jaeger-grpc: {enabled: false}
  zipkin: {enabled: false}
  metrics: {enabled: false}
service: {enabled: true, type: ClusterIP}
config:
  extensions:
    azure_auth:
      workload_identity:
        client_id: '$${env:AZURE_CLIENT_ID}'
        tenant_id: '$${env:AZURE_TENANT_ID}'
        federated_token_file: '$${env:AZURE_FEDERATED_TOKEN_FILE}'
      scopes: ['https://monitor.azure.com/.default']
  receivers:
    jaeger: null
    zipkin: null
    prometheus: null
    otlp:
      protocols:
        grpc: {endpoint: '$${env:MY_POD_IP}:4317'}
        http: null
  processors:
    memory_limiter: {check_interval: 1s, limit_percentage: 75, spike_limit_percentage: 15}
    batch: {timeout: 5s, send_batch_size: 512, send_batch_max_size: 512}
  exporters:
    debug: null
    otlp_http/azure:
      traces_endpoint: '${trace_endpoint}'
      encoding: proto
      compression: none
      auth: {authenticator: azure_auth}
      sending_queue: {enabled: true, queue_size: 100, num_consumers: 1}
      retry_on_failure: {enabled: true, initial_interval: 1s, max_interval: 10s, max_elapsed_time: 60s}
  service:
    extensions: [health_check, azure_auth]
    pipelines:
      logs: null
      metrics: null
      traces: {receivers: [otlp], processors: [memory_limiter, batch], exporters: [otlp_http/azure]}
