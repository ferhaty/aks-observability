terraform {
  required_version = ">= 1.10.0, < 2.0.0"
  required_providers {
    helm = { source = "hashicorp/helm", version = "3.3.0" }
  }
  # Configure a DISTINCT state key through the existing pipeline/backend.
}
variable "environment" {
  description = "Generated by the existing AKS owner's observability_inputs output; do not hand-copy resource IDs or endpoints."
  type = object({
    tenant_id            = string
    collector_client_id  = string
    grafana_client_id    = string
    trace_endpoint       = string
    prometheus_query_url = string
  })
  validation {
    condition     = startswith(var.environment.trace_endpoint, "https://") && endswith(var.environment.trace_endpoint, "/streams/Microsoft-OTLP-Traces/otlp/v1/traces") && startswith(var.environment.prometheus_query_url, "https://")
    error_message = "Require the generated full HTTPS OTLP trace URL and Prometheus query URL."
  }
  validation {
    condition     = var.environment.collector_client_id != var.environment.grafana_client_id
    error_message = "Collector and Grafana must have separate identities."
  }
}
variable "kubeconfig_path" { type = string }
variable "kubeconfig_context" { type = string }
variable "grafana_admin_secret_name" {
  description = "Existing Kubernetes Secret in observability, with admin-user and admin-password keys."
  type        = string
  default     = "grafana-admin"
}
provider "helm" {
  kubernetes = {
    config_path    = var.kubeconfig_path
    config_context = var.kubeconfig_context
  }
}
